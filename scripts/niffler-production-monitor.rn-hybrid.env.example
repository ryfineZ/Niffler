MONITOR_NODE_NAME=rn-hybrid
MONITOR_NODE_DISPLAY_NAME="备用数据库服务器（rn-hybrid）"
MONITOR_TELEGRAM_CONFIG_FILE=/etc/niffler-monitor/telegram.env
MONITOR_DISK_PATH=/
MONITOR_DISK_LABEL=系统盘
MONITOR_DISK_WARNING_PERCENT=80
MONITOR_DISK_CRITICAL_PERCENT=90
MONITOR_FAILURE_THRESHOLD=3
MONITOR_CONTAINERS=niffler-postgres15
MONITOR_CONTAINER_LABELS=数据库服务
MONITOR_POSTGRES_CONTAINER=niffler-postgres15
MONITOR_POSTGRES_ROLE=standby
MONITOR_POSTGRES_LABEL=数据库从库
MONITOR_POSTGRES_PORT=5432
MONITOR_POSTGRES_MAX_REPLAY_LAG_BYTES=16777216
MONITOR_POSTGRES_LAG_IGNORE_SERVICE=niffler-postgres-backup.service
MONITOR_HTTP_URL=
MONITOR_REPORT_FILE=/var/lib/niffler-monitor/status.txt
