MONITOR_NODE_NAME=ovh-US-WEST-OR-VPS-4
MONITOR_NODE_DISPLAY_NAME="主应用服务器（OVH 美西）"
MONITOR_TELEGRAM_CONFIG_FILE=/etc/niffler-monitor/telegram.env
MONITOR_DISK_PATH=/
MONITOR_DISK_LABEL=系统盘
MONITOR_DISK_WARNING_PERCENT=80
MONITOR_DISK_CRITICAL_PERCENT=90
MONITOR_FAILURE_THRESHOLD=3
MONITOR_CONTAINERS=niffler-frontdoor,niffler-caddy
MONITOR_CONTAINER_LABELS=网站前台,HTTPS入口
MONITOR_HTTP_URL=https://ovh-origin.niffler.org/_gateway/health
MONITOR_HTTP_LABEL=Cloudflare访问
MONITOR_REPORT_FILE=/var/lib/niffler-monitor-control/status.txt
