(niffler_common) {
	encode gzip zstd
}

(niffler_origin_tls) {
	tls /etc/caddy/tls/niffler-origin.pem /etc/caddy/tls/niffler-origin.key
}

(no3realms_origin_tls) {
	tls /etc/caddy/tls/no3realms-origin.pem /etc/caddy/tls/no3realms-origin.key
}

(niffler_latency_probe) {
	@latency_probe path /__niffler_latency
	handle @latency_probe {
		header {
			Access-Control-Allow-Origin "*"
			Cache-Control "no-store, no-cache, must-revalidate"
			Timing-Allow-Origin "*"
		}
		respond 204
	}
}

us1.niffler.org {
	import niffler_common
	import niffler_latency_probe

	handle {
		reverse_proxy 127.0.0.1:18084
	}
}

api.niffler.org {
	import niffler_common
	import niffler_origin_tls
	reverse_proxy 127.0.0.1:18084
}

no3realms.com, www.no3realms.com {
	import niffler_common
	import no3realms_origin_tls
	reverse_proxy 127.0.0.1:18084
}

global.niffler.org {
	import niffler_common
	import niffler_origin_tls
	respond 404
}

niffler.org {
	import niffler_common
	import niffler_origin_tls

	@infinite_canvas_root path /InfiniteCanvas
	redir @infinite_canvas_root /InfiniteCanvas/ 308

	handle /InfiniteCanvas/* {
		reverse_proxy {$INFINITE_CANVAS_ORIGIN} {
			header_up Host niffler.org
			transport http {
				tls_server_name niffler.org
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:18084
	}
}

ovh-origin.niffler.org {
	import niffler_common
	reverse_proxy 127.0.0.1:18084
}

autocar.3jiezhiwai.com {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @not_cloudflare 403

	encode gzip zstd
	reverse_proxy 127.0.0.1:18792 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
	}
}
