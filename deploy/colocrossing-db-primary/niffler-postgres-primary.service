[Unit]
Description=Niffler PostgreSQL 15 primary
Wants=network-online.target
After=network-online.target docker.service wg-quick@wg-db.service
Requires=docker.service wg-quick@wg-db.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/niffler-postgres-primary
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300
TimeoutStopSec=360

[Install]
WantedBy=multi-user.target
