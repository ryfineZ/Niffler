[Unit]
Description=Niffler PostgreSQL 15 candidate
Wants=network-online.target
After=network-online.target docker.service wg-quick@wg-db.service
Requires=docker.service wg-quick@wg-db.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/niffler-postgres-candidate
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
